# Catalyst Project
CATALYST_PROJECT_ID=50009000000018001
# CATALYST_API_TOKEN is the short-lived (~1h) OAuth ACCESS token. It is used as
# a fallback/bootstrap only — at runtime the backend auto-refreshes its own
# access token from the refresh token below (see backend/config/catalyst_token.py),
# so this value no longer needs manual rotation once the refresh creds are set.
CATALYST_API_TOKEN=1000.784beb533c15a7e5c1df13842ea6d8b3.b05092e512bc21e66a45d5e56fa752ae
CATALYST_ORG_ID=60074122671
CATALYST_BASE_URL=https://api.catalyst.zoho.in

# OAuth refresh credentials — the backend uses these to mint fresh access
# tokens automatically (the refresh token does NOT expire). Without them the
# backend falls back to the static CATALYST_API_TOKEN above (which dies in ~1h).
CATALYST_CLIENT_ID=1000.AKUAJRBYOHKPK97M5GC0A3E963XS6J
CATALYST_CLIENT_SECRET=c9e104a50a44796e9c86c3d02c98fa8e8fc7b2105a
CATALYST_REFRESH_TOKEN=1000.83c58573290a8532bef373d3c0421876.835aeb9a9d86ffad4af2871266674b7c
# OAuth accounts endpoint (region-specific: .in / .com / .eu). Auto-derived from
# CATALYST_BASE_URL when unset.
CATALYST_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token

