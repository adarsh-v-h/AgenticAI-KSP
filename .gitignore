# NOTE: .env IS committed to this repo intentionally. The repository is PRIVATE
# with a small set of trusted contributors, and a single shared deployment means
# everyone works against the same backend/DB/Catalyst project. This is a
# deliberate tradeoff — if the repo is ever made public, remove the .env files
# from tracking and rotate every secret immediately. Generated per-deploy
# artifacts that also contain secrets (backend/app-config.json) stay ignored.
__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
dist/
build/
.venv/
venv/
.obsidian/
.idea/
.phases/
*.kiro
.vscode/
.pytest_cache/
backend/rag_export/
backend/rag_consolidated/
rag_export/
.codex
.agents
.hypothesis

# Catalyst deployment
.catalystrc
*.so

# Generated AppSail config — contains real secrets from .env, never commit.
# Regenerated by scripts/gen_app_config.py (see backend/app-config.template.json).
backend/app-config.json

# Frontend build output copied into client-package (regenerated by deploy.sh)
# Only client-package.json is version-controlled; the rest is build output.
client-package/assets/
client-package/*.png
client-package/*.jpeg
client-package/index.html

# Vendored Python deps bundled into backend/ for AppSail deploy
# (regenerated by the predeploy script: pip install -r requirements.txt -t .)
backend/*.dist-info/
backend/aiomysql/
backend/annotated_types/
backend/anyio/
backend/bcrypt/
backend/bin/
backend/certifi/
backend/cffi/
backend/click/
backend/cryptography/
backend/defusedxml/
backend/dotenv/
backend/ecdsa/
backend/exceptiongroup/
backend/fastapi/
