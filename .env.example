# =============================================================================
# KSP Crime Intelligence Chatbot — environment template
# Copy this file to ".env" and fill every value. Missing or empty REQUIRED
# variables will crash the FastAPI server on startup (see
# backend/config/settings.py — REQUIRED_VARS). Variables marked OPTIONAL are
# reserved for not-yet-implemented integrations and do NOT block startup.
# Never commit your real .env — it stays in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Catalyst project identity
# -----------------------------------------------------------------------------
# OPTIONAL — reserved for future use; not read by any current code path.
CATALYST_PROJECT_ID=your_catalyst_project_id

# REQUIRED. Numeric organization id. Sent as the "CATALYST-ORG" header on every
# Catalyst API call (LLM, NoSQL).
CATALYST_ORG_ID=your_catalyst_org_id

# REQUIRED (bootstrap/fallback). OAuth ACCESS token, short-lived (~1h). Used only
# as a fallback — at runtime the backend auto-refreshes its own access token from
# the refresh credentials below (see backend/config/catalyst_token.py), so this
# no longer needs manual rotation once those are set.
CATALYST_API_TOKEN=your_catalyst_api_token

# RECOMMENDED. OAuth refresh credentials — let the backend mint fresh access
# tokens automatically (the refresh token does NOT expire). Without these the
# backend falls back to the static CATALYST_API_TOKEN, which dies in ~1h.
# Get them from the Zoho API Console (https://api-console.zoho.in/): create a
# Self Client / Server-based app, then generate a refresh token via OAuth.
CATALYST_CLIENT_ID=your_oauth_client_id
CATALYST_CLIENT_SECRET=your_oauth_client_secret
CATALYST_REFRESH_TOKEN=your_oauth_refresh_token
# OPTIONAL — OAuth token endpoint (region-specific). Auto-derived from
# CATALYST_BASE_URL when unset. .in / .com / .eu.
CATALYST_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token

# OPTIONAL — region base URL. Also used to derive CATALYST_ACCOUNTS_URL.
#   India:  https://api.catalyst.zoho.in
#   US:     https://api.catalyst.zoho.com
#   EU:     https://api.catalyst.zoho.eu
CATALYST_BASE_URL=https://api.catalyst.zoho.in


# -----------------------------------------------------------------------------
# QuickML — LLM serving  (REQUIRED)
# -----------------------------------------------------------------------------
# Full chat endpoint. Pattern: {CATALYST_BASE_URL}/quickml/v1/project/{CATALYST_PROJECT_ID}/glm/chat
QUICKML_LLM_URL=https://api.catalyst.zoho.in/quickml/v1/project/your_catalyst_project_id/glm/chat

# Model identifier — GLM-4.7-Flash (single model for both SQL generation and answer formatting)
MODEL_SQL=crm-di-glm47b_30b_it
MODEL_ANSWER=crm-di-glm47b_30b_it
# OPTIONAL — vision model reserved for future use; not read by current code.
MODEL_VISION=qwen2.5-7b-vl

# RAG knowledge-base document IDs (comma-separated) the chatbot grounds
# narrative/analytical answers against. Populated by `python backend/kb_sync.py`
# after uploading case documents to the Catalyst KB. If empty, RAG fallback
# runs with zero documents (SQL answers still work). Leave blank until synced.
KB_DOCUMENT_IDS=


# -----------------------------------------------------------------------------
# Database — AWS RDS MySQL (ap-south-1)  (REQUIRED)
# -----------------------------------------------------------------------------
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ksp_crime_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password


# -----------------------------------------------------------------------------
# Catalyst NoSQL — conversation history + session metadata storage  (REQUIRED)
# -----------------------------------------------------------------------------
# Pattern: {CATALYST_BASE_URL}/baas/v1/project/{CATALYST_PROJECT_ID}/nosql
NOSQL_BASE_URL=https://api.catalyst.zoho.in/baas/v1/project/your_catalyst_project_id/nosql


# -----------------------------------------------------------------------------
# OPTIONAL — reserved for not-yet-implemented integrations
# -----------------------------------------------------------------------------
# None of the URLs below are read by the current code base. They are kept here
# so the slots are documented for when Stratus media, Zia voice/translation, and
# SmartBrowz export are wired up. Leaving them blank will NOT crash startup.

# Catalyst Cache — shared counter store for the station-wide rate limiter.
# CACHE_BASE_URL pattern: {CATALYST_BASE_URL}/baas/v1/project/{CATALYST_PROJECT_ID}/cache
# CACHE_SEGMENT_ID: create a Cache segment in the Catalyst console (Cache ->
# Segments) and paste its numeric ID. If blank, the limiter still works
# per-instance (in-memory) but won't converge counts across AppSail instances.
CACHE_BASE_URL=https://api.catalyst.zoho.in/baas/v1/project/your_catalyst_project_id/cache
CACHE_SEGMENT_ID=

# Catalyst Stratus — evidence media (images, audio, video) object store.
# Pattern: {CATALYST_BASE_URL}/baas/v1/project/{CATALYST_PROJECT_ID}/folder
STRATUS_BASE_URL=https://api.catalyst.zoho.in/baas/v1/project/your_catalyst_project_id/folder

# Zia Services — voice (STT/TTS) + translation. Powers /api/voice/*.
# These are the QuickML Zia model endpoints (region host + /quickml/api/v1/...).
ZIA_STT_URL=https://api.catalyst.zoho.in/quickml/api/v1/models/zia/audio/transcribe
ZIA_TTS_URL=https://api.catalyst.zoho.in/quickml/api/v1/models/zia/tts/synthesize
ZIA_TRANSLATE_URL=https://api.catalyst.zoho.in/quickml/api/v1/models/zia/translate

# SmartBrowz — headless browser / PDF export.
# Pattern: {CATALYST_BASE_URL}/baas/v1/project/{CATALYST_PROJECT_ID}/smartbrowz
SMARTBROWZ_URL=https://api.catalyst.zoho.in/baas/v1/project/your_catalyst_project_id/smartbrowz


# -----------------------------------------------------------------------------
# App configuration  (REQUIRED)
# -----------------------------------------------------------------------------
# "development" or "production". Reported by /health.
APP_ENV=development

# JWT signing key used by backend/auth/simple_auth.py. Generate a fresh
# 32+ character random string per environment. NEVER reuse across environments.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=replace_me_with_a_32_plus_char_random_string

# Comma-separated origins permitted by FastAPI CORS. Local Vite dev defaults
# to port 5173. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:5173


# =============================================================================
# Refreshing CATALYST_API_TOKEN (optional reference)
# -----------------------------------------------------------------------------
# Catalyst access tokens expire after ~1 hour. Use your refresh token + Zoho
# OAuth client credentials to mint a new one. Keep these secrets out of git.
#
#   curl -X POST "https://accounts.zoho.in/oauth/v2/token" \
#     -d "grant_type=refresh_token" \
#     -d "client_id=YOUR_CLIENT_ID" \
#     -d "client_secret=YOUR_CLIENT_SECRET" \
#     -d "refresh_token=YOUR_REFRESH_TOKEN"
#
# The response's "access_token" field becomes the new CATALYST_API_TOKEN.
# =============================================================================
